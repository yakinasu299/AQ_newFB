<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
<!-- This site is hosted on Netlify. Anyone can build and deploy a site
     like this one for free: https://netlify.new/?utm_campaign=loops&utm_source=ai-legible&utm_medium=owned&utm_content=comment&utm_id=a67bbb21-8eac-479c-946a-5ac6d8760b1e
     Netlify hosting facts for this site: static/SSR served via Netlify Edge. -->
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>AQ 所見ジェネレーター</title>
  <meta name="description" content="AQの得点データを入力すると、所見文を自動生成するツールです。">
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@300;400;500;600;700&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --bg: #ffffff;
      --surface: rgba(0,0,0,0.03);
      --surface-hover: rgba(0,0,0,0.06);
      --border: rgba(0,0,0,0.12);
      --accent: #5b4de0;
      --accent-glow: rgba(91,77,224,0.2);
      --accent2: #0d9e7a;
      --text: #1a1a2e;
      --text-muted: #5a5870;
      --radius: 16px;
      --shadow: 0 8px 32px rgba(0,0,0,0.4);
    }
    html { scroll-behavior: smooth; }
    body {
      background: var(--bg);
      color: var(--text);
      font-family: 'Noto Sans JP', 'Inter', sans-serif;
      min-height: 100vh;
      padding: 0 0 60px;
      background-image:
        radial-gradient(ellipse at 20% 10%, rgba(91,77,224,0.05) 0%, transparent 55%),
        radial-gradient(ellipse at 80% 90%, rgba(13,158,122,0.04) 0%, transparent 50%);
    }
    header {
      text-align: center;
      padding: 52px 20px 36px;
      position: relative;
    }
    header::after {
      content: '';
      display: block;
      width: 120px;
      height: 2px;
      background: linear-gradient(90deg, transparent, var(--accent), transparent);
      margin: 24px auto 0;
    }
    .badge {
      display: inline-block;
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 2px;
      text-transform: uppercase;
      color: var(--accent2);
      background: rgba(91,229,197,0.1);
      border: 1px solid rgba(91,229,197,0.25);
      padding: 4px 14px;
      border-radius: 100px;
      margin-bottom: 16px;
    }
    h1 {
      font-size: clamp(24px, 4vw, 40px);
      font-weight: 700;
      letter-spacing: -0.5px;
      color: var(--accent);
    }
    .subtitle { margin-top: 10px; color: var(--text-muted); font-size: 14px; }
    .container { max-width: 900px; margin: 0 auto; padding: 0 20px; }
    .card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 28px;
      margin-bottom: 20px;
      backdrop-filter: blur(12px);
      box-shadow: var(--shadow);
      transition: border-color 0.2s;
    }
    .card:hover { border-color: rgba(255,255,255,0.14); }
    .card-label {
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      color: var(--accent);
      margin-bottom: 14px;
    }
    textarea {
      width: 100%;
      background: rgba(0,0,0,0.03);
      border: 1px solid var(--border);
      border-radius: 10px;
      color: var(--text);
      font-family: 'Noto Sans JP', monospace;
      font-size: 13.5px;
      line-height: 1.8;
      padding: 16px;
      resize: vertical;
      outline: none;
      transition: border-color 0.2s, box-shadow 0.2s;
    }
    textarea:focus {
      border-color: var(--accent);
      box-shadow: 0 0 0 3px var(--accent-glow);
    }
    #input-area    { min-height: 200px; }
    #findings-area { min-height: 380px; }
    .btn-row {
      display: flex;
      gap: 12px;
      margin-top: 16px;
      flex-wrap: wrap;
      align-items: center;
    }
    button {
      cursor: pointer;
      border: none;
      border-radius: 10px;
      font-family: inherit;
      font-size: 14px;
      font-weight: 600;
      padding: 12px 24px;
      transition: all 0.18s ease;
      display: inline-flex;
      align-items: center;
      gap: 8px;
    }
    .btn-primary {
      background: linear-gradient(135deg, var(--accent), #9d6ff7);
      color: #fff;
      box-shadow: 0 4px 16px rgba(124,106,247,0.35);
    }
    .btn-primary:hover { transform: translateY(-1px); box-shadow: 0 6px 24px rgba(124,106,247,0.5); }
    .btn-primary:active { transform: translateY(0); }
    .btn-secondary {
      background: var(--surface-hover);
      color: var(--text);
      border: 1px solid var(--border);
    }
    .btn-secondary:hover { background: rgba(255,255,255,0.1); border-color: rgba(255,255,255,0.18); }
    .btn-copy {
      background: linear-gradient(135deg, #1f6f5c, var(--accent2));
      color: #fff;
      box-shadow: 0 4px 16px rgba(91,229,197,0.25);
    }
    .btn-copy:hover { transform: translateY(-1px); box-shadow: 0 6px 24px rgba(91,229,197,0.4); }
    .copy-feedback { font-size: 13px; color: var(--accent2); opacity: 0; transition: opacity 0.3s; }
    .copy-feedback.show { opacity: 1; }
    .section-divider { border: none; border-top: 1px solid var(--border); margin: 8px 0 20px; }
    .hint {
      font-size: 12px;
      color: var(--text-muted);
      margin-top: 10px;
      line-height: 1.7;
    }
    @media(max-width:600px){
      .card { padding: 20px; }
      .btn-row { flex-direction: column; }
      button { width: 100%; justify-content: center; }
    }
    @keyframes fadeUp {
      from { opacity:0; transform:translateY(12px); }
      to   { opacity:1; transform:translateY(0); }
    }
    .fade-up { animation: fadeUp 0.4s ease both; }
  </style>
</head>
<body>
<header>
  <div class="badge">心理検査ツール</div>
  <h1>AQ 所見ジェネレーター</h1>
  <p class="subtitle">得点データをテキストで貼り付けると、所見文を自動で生成します</p>
</header>

<div class="container">
  <div class="card">
    <div class="card-label">📋 AQ データを貼り付け</div>
    <textarea id="input-area" placeholder="■ AQ
総合　　　　　33点/50点（カットオフ33点）
社会的スキル　 9点/10点（カットオフ 6点）
注意の切り替え　8点/10点（カットオフ 7点）
細部への関心　 7点/10点（カットオフなし）
コミュニケーション　6点/10点（カットオフ 6点）
想像力　　　　 3点/10点（カットオフ 6点）"></textarea>
    <p class="hint">※「総合」「社会的スキル」「注意の切り替え」「細部への関心」「コミュニケーション」「想像力」の各行を含む形式で貼り付けてください。</p>
    <div class="btn-row">
      <button class="btn-primary" onclick="parseAndGenerate()"><span>✦</span> 所見を生成する</button>
      <button class="btn-secondary" onclick="clearAll()">クリア</button>
    </div>
  </div>

  <div class="card" id="findings-section" style="display:none">
    <div class="card-label">📝 所見（編集可能）</div>
    <hr class="section-divider">
    <textarea id="findings-area"></textarea>
    <div class="btn-row">
      <button class="btn-copy" onclick="copyFindings()"><span>📄</span> テキストをコピー</button>
      <span class="copy-feedback" id="copy-feedback">✓ コピーしました</span>
    </div>
  </div>
</div>

<script>
// ── パース ──────────────────────────────────
function parseScores(text) {
  const scores = {
    total: null, social: null, attention: null,
    detail: null, communication: null, imagination: null,
    totalCO: null, socialCO: null, attentionCO: null,
    communicationCO: null, imaginationCO: null
  };

  for (const line of text.split('\n')) {
    let m = line.match(/総合.+?(\d+)点[^\d]/);
    if (m) scores.total = parseInt(m[1]);
    m = line.match(/総合.+?カットオフ\s*(\d+)点/);
    if (m) scores.totalCO = parseInt(m[1]);

    m = line.match(/社会的スキル.+?(\d+)点[^\d]/);
    if (m) scores.social = parseInt(m[1]);
    m = line.match(/社会的スキル.+?カットオフ\s*(\d+)点/);
    if (m) scores.socialCO = parseInt(m[1]);

    m = line.match(/注意の切り替え.+?(\d+)点[^\d]/);
    if (m) scores.attention = parseInt(m[1]);
    m = line.match(/注意の切り替え.+?カットオフ\s*(\d+)点/);
    if (m) scores.attentionCO = parseInt(m[1]);

    m = line.match(/細部への関心.+?(\d+)点[^\d]/);
    if (m) scores.detail = parseInt(m[1]);

    m = line.match(/コミュニケーション.+?(\d+)点[^\d]/);
    if (m) scores.communication = parseInt(m[1]);
    m = line.match(/コミュニケーション.+?カットオフ\s*(\d+)点/);
    if (m) scores.communicationCO = parseInt(m[1]);

    m = line.match(/想像力.+?(\d+)点[^\d]/);
    if (m) scores.imagination = parseInt(m[1]);
    m = line.match(/想像力.+?カットオフ\s*(\d+)点/);
    if (m) scores.imaginationCO = parseInt(m[1]);
  }
  return scores;
}

// ── 4段階判定 ──────────────────────────────────
function grade(score, co, max) {
  if (score == null || co == null) return null;
  const bigHigh = co + (max - co) * 0.5;
  const bigLow  = co * 0.5;
  if (score >= bigHigh) return 'vhigh';
  if (score >= co)      return 'high';
  if (score >= bigLow)  return 'low';
  return 'vlow';
}

// ── 所見生成 ────────────────────────────────
function generateFindings(sc) {
  const { total, totalCO, social, socialCO, attention, attentionCO,
          detail, communication, communicationCO, imagination, imaginationCO } = sc;

  const parts = [];
  const gTotal  = grade(total, totalCO, 50);
  const gSocial = grade(social, socialCO, 10);
  const gAttn   = grade(attention, attentionCO, 10);
  const gComm   = grade(communication, communicationCO, 10);
  const gImag   = grade(imagination, imaginationCO, 10);
  const gDetail = grade(detail, 5, 10);

  const isHigh = g => g === 'vhigh' || g === 'high';
  const totalHigh = isHigh(gTotal);
  const anyHigh = [gSocial, gAttn, gDetail, gComm, gImag].some(isHigh);

  function addAbove(title, gradeValue, problems, advice) {
    const level = gradeValue === 'vhigh' ? '特に目安の値を上回る' : '目安の値を上回る';
    parts.push(
      `**「${title}」**は${level}結果でした。\n\n` +
      '〇困りごと\n\n' + problems.map(x => '・' + x).join('\n\n') +
      '\n\n〇対策とアドバイス\n\n' + advice.map(x => '・' + x).join('\n\n')
    );
  }

  function addBelow(title, gradeValue, text) {
    const level = gradeValue === 'vlow' ? '目安の値を大きく下回っており' : '目安の値を下回っており';
    parts.push(`**「${title}」**は${level}、${text}`);
  }

  // ── 総合判定・冒頭 ──
  if (total != null) {
    if (totalHigh) {
      parts.push(
        `【所見】AQ総合得点は${total}点と**カットオフ値以上であり、ASD特性がうかがわれる**結果となりました。\n\n` +
        'ただし、AQは特性の傾向を把握するための質問紙であり、得点のみで診断を確定するものではありません。以下に下位項目ごとの特徴を説明します。'
      );
    } else {
      parts.push(
        `【所見】AQ総合得点は${total}点と**カットオフ値を下回り、ASD傾向はうかがえない**結果となりました。\n\n` +
        'ただし、下位項目を見ると、場面によってはASD特性を感じることがあるかもしれません。以下に詳しく説明します。'
      );
    }
  }

  // ── 社会的スキル ──
  if (social != null) {
    if (isHigh(gSocial)) {
      addAbove('社会的スキル', gSocial,
        gSocial === 'vhigh' ? [
          '人との関わりの中で、どのように立ち振る舞えばよいかとっさに判断しにくい',
          'その場にふさわしい話題を思いつくことが難しい',
          '人との関わりのあとに疲れを感じやすく、初対面の相手との会話で緊張しやすい'
        ] : [
          '人との関わりの中で、どのように立ち振る舞えばよいかとっさに判断しにくいことがある',
          'その場にふさわしい話題を思いつくことが難しい場面がある',
          '人との関わりのあとに疲れを感じやすかったり、初対面の相手との会話で緊張しやすかったりする'
        ],
        gSocial === 'vhigh' ? [
          'よく聞かれる質問の答えや会話のきっかけを事前にいくつか考えておく',
          '人と関わる場面の前後に、一人で気持ちをリセットできる時間を設ける',
          '複数人での会話が負担になる場合は、少人数や一対一で話す機会を選ぶ'
        ] : [
          'よく聞かれる質問の答えを事前に考えておく',
          '人と関わる場面の前後に一人でリセットできる時間を設ける'
        ]
      );
    } else {
      addBelow('社会的スキル', gSocial,
        '人との関わりにおいて比較的スムーズにやり取りができる傾向がうかがえます。初対面の相手とも会話を始めたり、その場の雰囲気に合わせて対応したりすることが比較的自然にできるようです。こうした対人面での柔軟さは、職場や日常の人間関係において強みとして活かせるでしょう。');
    }
  }

  // ── 注意の切り替え ──
  if (attention != null) {
    if (isHigh(gAttn)) {
      addAbove('注意の切り替え', gAttn,
        gAttn === 'vhigh' ? [
          '一度取り組んでいることから別のことへ意識を切り替えるのに、時間や労力がかかる',
          '急な予定変更や割り込みの作業が生じたとき、気持ちの整理に時間がかかる',
          '決まったやり方や手順が変わると、戸惑いや負担を感じやすい'
        ] : [
          '取り組んでいることから別のことへ移るのに、時間がかかることがある',
          '急な予定変更や予期しない出来事に直面したとき、気持ちの整理に少し手間取る場面がある'
        ],
        gAttn === 'vhigh' ? [
          '1日のスケジュールや作業の順番をあらかじめ決めておく',
          '予定変更が生じる可能性がある場合は、代替案を事前に考えておく',
          '作業を切り替える前に、区切りの時間や準備時間を設ける'
        ] : [
          '1日のスケジュールをあらかじめ決めておく',
          '変更が生じた際の代替案を考えておく'
        ]
      );
    } else {
      addBelow('注意の切り替え', gAttn,
        '状況の変化に比較的柔軟に対応できる傾向がうかがえます。予定が変わったときにも気持ちを切り替えやすく、新しい状況に合わせて対応できる力があるようです。こうした柔軟性は、変化の多い環境や臨機応変な対応が求められる場面で強みとなるでしょう。');
    }
  }

  // ── 細部への関心 ──
  if (detail != null) {
    if (isHigh(gDetail)) {
      addAbove('細部への関心', gDetail,
        gDetail === 'vhigh' ? [
          '物事の細かな部分や微妙な変化が気になり、意識が向きやすい',
          '細部を確認することに時間をかけ、全体の作業に時間がかかることがある',
          '周囲の刺激や小さな違いが気になり、疲れを感じる場面がある'
        ] : [
          '物事の細かな部分や微妙な変化に気づきやすい',
          '細部が気になり、作業に時間がかかることがある'
        ],
        gDetail === 'vhigh' ? [
          '作業を始める前に、全体の目的や優先順位を確認しておく',
          '確認する範囲や時間をあらかじめ決めておく',
          '必要に応じて仕切りなどを使い、集中しやすい環境を整える'
        ] : [
          '作業の最初に全体の流れや優先順位を確認する',
          '細部の確認に使う時間をあらかじめ決めておく'
        ]
      );
    } else {
      addBelow('細部への関心', gDetail,
        '細かな規則性や細部に強くこだわるというよりも、全体の流れを大まかに把握しながら物事を進めるスタイルが合っていると考えられます。こうした全体志向の視点は、複数の情報を俯瞰して判断したり、優先順位をつけて動いたりする場面で力を発揮します。');
    }
  }

  // ── コミュニケーション ──
  if (communication != null) {
    if (isHigh(gComm)) {
      addAbove('コミュニケーション', gComm,
        gComm === 'vhigh' ? [
          '相手の言葉の裏にある意図や、表情・声のトーンから気持ちを読み取ることが難しい',
          '冗談や比喩表現を字義通りに受け取ってしまうことがある',
          '会話のテンポについていくことに難しさを感じ、人との関わりの後に疲れやすい'
        ] : [
          '相手の言葉の裏にある意図や、表情・声のトーンから気持ちを読み取ること',
          '冗談や比喩表現を字義通りに受け取ってしまう',
          '会話のテンポについていくのが難しく感じることがある'
        ],
        gComm === 'vhigh' ? [
          'よくわからなかったときは、相手に確認することを習慣にする',
          '口頭でのやり取りが難しい場合は、文字やメールなどで確認する',
          '人と関わる機会が続いた後には、休息できる時間を確保する'
        ] : [
          '「よくわからなかったときは素直に確認する」というルールを自分に設けておく',
          '周囲の人のコミュニケーションの取り方を観察し、良いところを取り入れる'
        ]
      );
    } else {
      addBelow('コミュニケーション', gComm,
        '相手の意図や場の雰囲気を読み取り、状況に応じた言葉を選ぶことが比較的スムーズにできる傾向がうかがえます。こうしたコミュニケーション面での柔軟さは、人と協力して物事を進めたり、対人関係を築いたりする場面で強みとなるでしょう。');
    }
  }

  // ── 想像力 ──
  if (imagination != null) {
    if (isHigh(gImag)) {
      addAbove('想像力', gImag,
        gImag === 'vhigh' ? [
          'これから起こりそうな場面や、相手の気持ち・立場を想像することに難しさを感じる',
          '先の見通しが立ちにくい状況や突発的な出来事に、ストレスを感じやすい',
          '状況が曖昧なままだと、どのように行動すればよいか迷うことがある'
        ] : [
          'これから起こりそうな場面や、相手の気持ち・立場を想像することに難しさを感じる場面がある',
          '先の見通しが立ちにくい状況でストレスを感じやすいことがある'
        ],
        gImag === 'vhigh' ? [
          '予定や手順を事前に確認し、先の見通しを具体的にしておく',
          '相手の気持ちを確認したいときは、推測だけで判断せず直接尋ねる',
          '「もしこうなったら」と複数の対応方法をあらかじめ考えておく'
        ] : [
          '事前に「もし〇〇になったら」というシナリオを考えておく',
          '予定や手順をあらかじめ確認し、見通しを持てるようにする'
        ]
      );
    } else {
      addBelow('想像力', gImag,
        '状況や相手の気持ちをイメージすることが比較的スムーズにできる傾向がうかがえます。相手の立場や感情を汲み取り、先の展開を考えながら行動する力があるようです。こうした想像力は、人との関係を築いたり、先を見通して計画的に行動したりする場面で強みとして活かせるでしょう。');
    }
  }

  // ── 締め ──
  if (totalHigh && anyHigh) {
    parts.push(
      '全体として、今回の結果では、下位項目にもいくつか特徴が見られました。こうした傾向は、日常生活のすべての場面に当てはまるものではなく、環境や状況によって現れ方が異なることがあります。\n\n' +
      '自分の特性を理解し、負担を感じやすい場面では事前の準備や環境の調整、周囲のサポートを取り入れることで、より過ごしやすい形を見つけていくことができるでしょう。'
    );
  } else if (anyHigh) {
    parts.push(
      '全体の得点はカットオフ値を下回っていますが、一部の下位項目に特徴が見られます。こうした傾向はあくまで場面によって現れる可能性があるものです。\n\n' +
      '自分に合ったペースで日常と向き合い、負担を感じやすい場面では工夫やサポートを取り入れることで、より過ごしやすい形を見つけていくことができるでしょう。'
    );
  } else {
    parts.push(
      '今回の結果では、全体として目安の値を上回る特徴は目立ちませんでした。下位項目にはそれぞれ個人差があり、得意なことや負担を感じやすい場面は状況によって異なります。\n\n' +
      'ご自身の得意なことを活かしながら、無理のないペースで日常生活を送ることが大切です。'
    );
  }

  return parts.join('\n\n');
}

// ── メイン ──────────────────────────────────
function parseAndGenerate() {
  const raw = document.getElementById('input-area').value.trim();
  if (!raw) { alert('データを入力してください。'); return; }
  const scores = parseScores(raw);
  if (scores.total === null && scores.social === null) {
    alert('スコアを読み取れませんでした。形式を確認してください。\n例: 総合　33点/50点（目安の値33点）');
    return;
  }
  const sec = document.getElementById('findings-section');
  sec.style.display = 'block';
  sec.classList.add('fade-up');
  document.getElementById('findings-area').value = generateFindings(scores);
  setTimeout(() => sec.scrollIntoView({ behavior: 'smooth', block: 'start' }), 100);
}

function clearAll() {
  document.getElementById('input-area').value = '';
  document.getElementById('findings-section').style.display = 'none';
}

function copyFindings() {
  const text = document.getElementById('findings-area').value;
  navigator.clipboard.writeText(text).then(() => {
    const fb = document.getElementById('copy-feedback');
    fb.classList.add('show');
    setTimeout(() => fb.classList.remove('show'), 2000);
  }).catch(() => {
    const ta = document.getElementById('findings-area');
    ta.select();
    document.execCommand('copy');
  });
}
</script>
